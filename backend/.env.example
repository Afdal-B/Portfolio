# Copy to .env and fill in to activate the real RAG pipeline.
# Without PORTFOLIO_GEMINI_API_KEY, the backend answers with the scripted
# keyword router: the app still works.

# Free key: https://aistudio.google.com/apikey
PORTFOLIO_GEMINI_API_KEY=

# Optional overrides (defaults shown):
# PORTFOLIO_GEMINI_MODEL=gemini-3.5-flash-lite
# PORTFOLIO_EMBEDDING_MODEL=gemini-embedding-001
# PORTFOLIO_EMBEDDING_DIMENSIONS=768
# PORTFOLIO_CHROMA_PATH=.chroma
# PORTFOLIO_RAG_TOP_K=6
# PORTFOLIO_RAG_MIN_SCORE=0.12
# PORTFOLIO_CHAT_RATE_LIMIT_PER_HOUR=20
